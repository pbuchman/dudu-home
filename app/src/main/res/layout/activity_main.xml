<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="28dp"
            android:paddingEnd="32dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:id="@+id/menu_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center" android:baselineAligned="false">
                <Button
                    android:id="@+id/open_gate_button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="150dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/button_primary"
                    android:text="@string/open_gate"
                    android:textAllCaps="false"
                    android:textColor="@color/background_top"
                    android:textSize="28sp" />
                <Button android:id="@+id/full_cleaning_button"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="150dp"
                    android:layout_marginTop="28dp" android:layout_marginStart="16dp"
                    android:background="@drawable/button_primary" android:text="@string/full_cleaning"
                    android:textAllCaps="false" android:textColor="@color/background_top" android:textSize="28sp" />
                </LinearLayout>
                <Button android:id="@+id/settings_button" android:layout_width="wrap_content"
                    android:layout_height="48dp" android:layout_marginTop="16dp"
                    android:text="@string/settings" android:textAllCaps="false" />
                <TextView
                    android:id="@+id/automation_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/roborock_setup_content" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/roborock_setup_title" android:textColor="@color/text_primary" android:textSize="30sp" />
                <TextView android:id="@+id/roborock_setup_message" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/roborock_setup_description" android:textColor="@color/text_secondary" android:textSize="17sp" />
                <EditText android:id="@+id/roborock_input" android:layout_width="match_parent" android:layout_height="64dp"
                    android:inputType="textPassword" android:importantForAutofill="no" android:saveEnabled="false"
                    android:hint="@string/roborock_setup_title" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
                <Button android:id="@+id/save_roborock_button" android:layout_width="wrap_content" android:layout_height="52dp"
                    android:text="@string/save_roborock" android:textAllCaps="false" />
                <Button android:id="@+id/cancel_roborock_button" android:layout_width="wrap_content" android:layout_height="48dp"
                    android:text="@string/back_to_menu" android:textAllCaps="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/number_setup_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxWidth="720dp"
                    android:text="@string/gate_number_title"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:maxWidth="680dp"
                    android:text="@string/gate_number_description"
                    android:textColor="@color/text_secondary"
                    android:textSize="17sp" />

                <EditText
                    android:id="@+id/gate_number_input"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="26dp"
                    android:backgroundTint="@color/accent_blue"
                    android:digits="+0123456789 ()-"
                    android:fontFamily="sans-serif"
                    android:gravity="center_vertical"
                    android:hint="@string/gate_number_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:saveEnabled="false"
                    android:inputType="phone"
                    android:maxWidth="560dp"
                    android:maxLines="1"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/gate_number_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:maxWidth="560dp"
                    android:textColor="@color/error_red"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/save_number_button"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/button_primary"
                    android:minWidth="220dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/save_and_continue"
                    android:textAllCaps="false"
                    android:textColor="@color/background_top"
                    android:textSize="16sp" />
                <Button android:id="@+id/cancel_number_button" android:layout_width="wrap_content"
                    android:layout_height="48dp" android:text="@string/back_to_menu" android:textAllCaps="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/call_status_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp">

                    <ProgressBar
                        android:id="@+id/progress"
                        style="?android:attr/progressBarStyleLarge"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/accent_blue" />

                    <ImageView
                        android:id="@+id/status_icon"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/success_icon_description"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/status_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxWidth="720dp"
                    android:text="@string/state_starting"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/status_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:maxWidth="680dp"
                    android:text="@string/state_starting_description"
                    android:textColor="@color/text_secondary"
                    android:textSize="17sp" />

                <LinearLayout
                    android:id="@+id/error_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/retry_button"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/button_primary"
                        android:minWidth="128dp"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="@string/retry"
                        android:textAllCaps="false"
                        android:textColor="@color/background_top"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/close_button"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/button_secondary"
                        android:minWidth="128dp"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="@string/close"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>

<com.pbuchman.duduhome.ui.ProgressPanel xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp"
    android:background="@drawable/progress_panel" android:importantForAccessibility="yes">
    <ScrollView android:id="@id/banner_body" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:fillViewport="false" android:overScrollMode="ifContentScrolls">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/banner_icon" android:layout_width="32dp" android:layout_height="32dp"
                    android:src="@drawable/ic_launcher" android:importantForAccessibility="no" />
                <TextView android:id="@+id/banner_title" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginStart="10dp"
                    android:textSize="22sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" />
            </LinearLayout>
            <TextView android:id="@+id/banner_detail" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:textSize="18sp" android:textColor="@color/text_primary" />
            <ProgressBar android:id="@+id/banner_progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="4dp"
                android:layout_marginTop="10dp" android:indeterminate="false" android:max="1000" />
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/banner_cancel_attempt" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:minHeight="76dp" android:minWidth="76dp"
        android:layout_marginStart="16dp" android:paddingHorizontal="16dp"
        android:background="@drawable/button_secondary" android:textColor="@color/text_primary"
        android:textSize="20sp" android:textAllCaps="false" android:text="@string/cancel_attempt"
        android:visibility="gone" />
</com.pbuchman.duduhome.ui.ProgressPanel>
